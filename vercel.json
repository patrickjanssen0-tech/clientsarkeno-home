{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/sahin",
      "destination": "https://sahin-ashen.vercel.app/"
    },
    {
      "source": "/sahin/:path*",
      "destination": "https://sahin-ashen.vercel.app/:path*"
    },
    {
      "source": "/saana",
      "destination": "https://saana-flame.vercel.app/"
    },
    {
      "source": "/saana/:path*",
      "destination": "https://saana-flame.vercel.app/:path*"
    }
  ]
}
